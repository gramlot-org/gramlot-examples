{"rows":[[[],"htmlDemo",null,"::X",{}],[["htmlDemo"],"content",null,"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>A real HTML document</title>\n<style>body {font: 17px system-ui; padding: 24px; color: #24334b} h1 {color: #3566aa} .note {background: #eaf1fc; padding: 16px; border-radius: 8px}</style></head>\n<body><h1>Hello, Gramlot!</h1><p>Edit this paragraph in <strong>Rich text</strong>, then inspect its HTML in Code.</p><p class=\"note\">Code, Preview and Rich text share one draft.</p>\n<!-- This comment stays in the source. -->\n<svg width=\"100\" height=\"50\" viewBox=\"0 0 100 50\"><circle cx=\"25\" cy=\"25\" r=\"20\" fill=\"#3566aa\"/></svg>\n<script>document.body.dataset.executed = \"yes\";</script>\n</body></html>",{}]]}::X