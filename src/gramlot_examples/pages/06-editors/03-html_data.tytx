{"rows":[[[],"htmlDemo",null,"::X",{}],[["htmlDemo"],"content",null,"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>A real HTML document</title>\n  <style>\n    body {font: 17px system-ui; padding: 24px; color: #24334b}\n    h1 {color: #3566aa}\n    .note {background: #eaf1fc; padding: 16px; border-radius: 8px}\n  </style>\n</head>\n<body>\n  <h1>Hello, Gramlot!</h1>\n  <p>Edit this paragraph in <strong>Rich text</strong>, then inspect its HTML in Code.</p>\n  <p class=\"note\">Code, Preview and Rich text share one draft.</p>\n<!-- This comment stays in the source. -->\n  <svg width=\"100\" height=\"50\" viewBox=\"0 0 100 50\">\n    <circle cx=\"25\" cy=\"25\" r=\"20\" fill=\"#3566aa\"/>\n  </svg>\n<script>document.body.dataset.executed = \"yes\";</script>\n</body>\n</html>",{}]]}::X