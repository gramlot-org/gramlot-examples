FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir --upgrade 'gramlot-py-server[uvicorn,gallery]' && pip check && useradd --uid 10001 --create-home gallery
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER gallery
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8080/assets/gramlot.js', method='HEAD'),timeout=4)"
CMD ["gramlot", "uvicorn", "gallery", "--host", "0.0.0.0", "--port", "8080", "--serverless-download", "/downloads/gramlot-gallery-serverless.zip"]
