# Deployment context contains public assets, entry-point configuration and checks; no credentials.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir --upgrade 'gramlot-py-server[kajenn,uvicorn,gallery]' 'asqueel[postgresql,migration]' 'asqueel-migration[postgresql,validation]' \
    && pip check \
    && python -c 'from gramlot_py_server.gallery.modules import stage_module' \
    && useradd --uid 10001 --create-home gallery
COPY public-module/ /app/modules/
COPY serve-mobile.py public_database.py verify-public-database.py verify-public-proxy.py /app/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER gallery
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/mobile-application/catalog.json', timeout=3).read()"
CMD ["python", "/app/serve-mobile.py", "--modules", "/app/modules", "--host", "0.0.0.0", "--port", "8080"]
