{
  "name": "gramlot-example-app",
  "version": "0.0.0-dev.1",
  "private": true,
  "type": "module",
  "description": "Equivalent Python and JavaScript Hello World pages for Gramlot",
  "license": "Apache-2.0",
  "exports": {
    "./pages/index": "./js/pages/index.js"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "js/pages",
    "js/server",
    "js/db"
  ],
  "scripts": {
    "test": "node --test js/tests/*.test.js",
    "test:bun": "bun test js/tests",
    "start:node": "node js/server/nodejs/start.js",
    "start:bun": "bun js/server/bun/start.js",
    "build:standalone": "gramlot-serverless build js/pages/index.js -o dist/hello-world.html"
  },
  "dependencies": {
    "@gramlot/native-html": "*",
    "gramlot-js-server": "*"
  },
  "devDependencies": {
    "jsdom": "27.0.1",
    "@gramlot/serverless": "*"
  },
  "bin": {
    "gramlot-hello-node": "./js/server/nodejs/start.js",
    "gramlot-hello-bun": "./js/server/bun/start.js"
  }
}
